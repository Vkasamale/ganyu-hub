NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# Required by: escrow release, the PayChangu callback/webhook routes, admin
# notifications, and the client-pays branch of requestRevision (BUG-007).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Base URL used to build OAuth/redirect links (e.g. Google login's redirectTo
# = <site>/auth/callback). Optional: falls back to https://ganyu-hub.vercel.app
# if unset, so prod works without it. Set to your localhost for local dev so the
# callback returns here, and add <this>/auth/callback to Supabase > Auth > URL
# Configuration > Redirect URLs. NOTE: Google's Client ID/Secret do NOT go here —
# they live only in the Supabase dashboard (Auth > Providers > Google).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by absUrl() for share links and email links. MUST be the production URL
# on Vercel — setting it to localhost is what broke Google login on 2026-08-05.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PayChangu (payments)
# ---------------------------------------------------------------------------
# There is no separate sandbox host — lib/payments.ts always calls
# https://api.paychangu.com. Live vs test is decided ENTIRELY by which secret
# key is set here. To test without real money, put a TEST key in Vercel's
# Preview + Development environments and keep the LIVE key on Production only;
# then a branch push gives you a preview URL running on test keys with no
# manual swapping to forget. See BACKLOG / TEST_LOG 2026-08-06.
PAYCHANGU_SECRET_KEY=YOUR-PAYCHANGU-SECRET-KEY

# Verifies webhook signatures on /api/paychangu/webhook.
# NOTE: PayChangu's webhook URL is a single global setting in their dashboard,
# so a preview deploy will NOT receive webhooks unless you repoint it (which
# would break production). The per-transaction callback_url DOES follow the
# preview, and runs the same idempotent settlement logic — so test via the
# callback, not the webhook.
PAYCHANGU_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# Mobile-money operator ids used when initiating payouts.
PAYCHANGU_AIRTEL_OP_ID=
PAYCHANGU_TNM_OP_ID=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Until ganyuhub.com is bought and verified, Resend runs in sandbox and only
# delivers to the account owner — beta creatives receive nothing.
RESEND_API_KEY=
EMAIL_FROM=Ganyu Hub <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Shared secret for the daily cron route. Compared timing-safe.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA on login + signup). Optional: if unset, the
# widget doesn't render and server verification is skipped, so the forms work
# unchanged. Get free keys at https://dash.cloudflare.com > Turnstile.
# For local dev you can use Cloudflare's always-pass test keys:
#   site   = 1x00000000000000000000AA
#   secret = 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to "false" to restore the 15% platform commission at public launch.
# Anything else (or unset) keeps the beta waiver: creatives keep 100%.
NEXT_PUBLIC_BETA_ZERO_COMMISSION=

# Plausible analytics — set to the site domain to activate the script tag.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
