{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/listings/**",
              "components/money/**",
              "components/navigation/**",
              "components/trust/**",
              "ui_kits/**",
              "ui_kits/mobile/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|chip|wash|mark|teal)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'chip' | 'wash' | 'mark' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomTabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|unreadCount|onNavigate|onMenu|position|key|ref|className|style|children)$/]",
        "message": "<BottomTabBar> doesn't accept that prop. Declared props: tabs, active, unreadCount, onNavigate, onMenu, position."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomTabBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<BottomTabBar> position must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|ghost|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'outline' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'default' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreativeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|location|headline|category|avatarUrl|skills|availability|rating|reviewCount|fromPriceMwk|showSave|saved|verifiedAt|key|ref|className|style|children)$/]",
        "message": "<CreativeCard> doesn't accept that prop. Declared props: name, location, headline, category, avatarUrl, skills, availability, rating, reviewCount, fromPriceMwk, showSave, saved, verifiedAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreativeCard'] > JSXAttribute[name.name='availability'] > Literal[value!=/^(?:available|busy|away)$/]",
        "message": "<CreativeCard> availability must be one of 'available' | 'busy' | 'away'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|actionLabel|actionHref|tone|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, actionLabel, actionHref, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:prompt|quiet)$/]",
        "message": "<EmptyState> tone must be one of 'prompt' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|seeAllHref|seeAllLabel|action|count|key|ref|className|style|children)$/]",
        "message": "<FeedCarousel> doesn't accept that prop. Declared props: title, eyebrow, seeAllHref, seeAllLabel, action, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|postedAgo|clientName|brief|budgetMwk|trustBits|proposalsCount|showSave|saved|key|ref|className|style|children)$/]",
        "message": "<JobCard> doesn't accept that prop. Declared props: title, category, postedAgo, clientName, brief, budgetMwk, trustBits, proposalsCount, showSave, saved."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:currentIdx|overlay|key|ref|className|style|children)$/]",
        "message": "<JobProgressBar> doesn't accept that prop. Declared props: currentIdx, overlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|markSrc|wordmark|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, markSrc, wordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Logo> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|defaultValue|placeholder|required|onValueChange|key|ref|className|style|children)$/]",
        "message": "<MoneyInput> doesn't accept that prop. Declared props: name, defaultValue, placeholder, required, onValueChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|size|basePath|key|ref|className|style|children)$/]",
        "message": "<MoneyStamp> doesn't accept that prop. Declared props: state, label, size, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyStamp'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:none|payment_pending|payment_held|payment_released|payment_disputed)$/]",
        "message": "<MoneyStamp> state must be one of 'none' | 'payment_pending' | 'payment_held' | 'payment_released' | 'payment_disputed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyStamp'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<MoneyStamp> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|href|count|key|ref|className|style|children)$/]",
        "message": "<PageTab> doesn't accept that prop. Declared props: key, label, href, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingExplainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:audience|betaZeroCommission|platformCommission|payoutRate|bankFlatFee|key|ref|className|style|children)$/]",
        "message": "<PricingExplainer> doesn't accept that prop. Declared props: audience, betaZeroCommission, platformCommission, payoutRate, bankFlatFee."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingExplainer'] > JSXAttribute[name.name='audience'] > Literal[value!=/^(?:client|creative|both)$/]",
        "message": "<PricingExplainer> audience must be one of 'client' | 'creative' | 'both'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onNavigate|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: items, active, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SaveButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:saved|onToggle|key|ref|className|style|children)$/]",
        "message": "<SaveButton> doesn't accept that prop. Declared props: saved, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchScope'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|onSelect|key|ref|className|style|children)$/]",
        "message": "<SearchScope> doesn't accept that prop. Declared props: current, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchScope'] > JSXAttribute[name.name='current'] > Literal[value!=/^(?:creatives|jobs)$/]",
        "message": "<SearchScope> current must be one of 'creatives' | 'jobs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|priceMwk|priceMaxMwk|deliveryDays|coverUrl|rating|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: title, description, priceMwk, priceMaxMwk, deliveryDays, coverUrl, rating."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRatingInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<StarRatingInput> doesn't accept that prop. Declared props: name, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stars'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|key|ref|className|style|children)$/]",
        "message": "<Stars> doesn't accept that prop. Declared props: value, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|href|position|key|ref|className|style|children)$/]",
        "message": "<StickyActionBar> doesn't accept that prop. Declared props: label, hint, href, position."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyActionBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<StickyActionBar> position must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StyleSwatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|key|ref|className|style|children)$/]",
        "message": "<StyleSwatch> doesn't accept that prop. Declared props: slug."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|defaultValue|placeholder|key|ref|className|style|children)$/]",
        "message": "<TagInput> doesn't accept that prop. Declared props: name, defaultValue, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifiedBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:verifiedAt|size|key|ref|className|style|children)$/]",
        "message": "<VerifiedBadge> doesn't accept that prop. Declared props: verifiedAt, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifiedBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<VerifiedBadge> size must be one of 'sm' | 'lg'."
      }
    ]
  },
